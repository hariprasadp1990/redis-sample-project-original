def sign_out(token):

    try:

        url = (
            CLOUD_URL.rstrip("/")
            + f"/api/{REST_API}/auth/signout"
        )

        headers = {
            "X-Tableau-Auth": token
        }

        requests.post(
            url,
            headers=headers,
            verify=VERIFY_SSL,
            timeout=30
        )

    except Exception:
        pass


